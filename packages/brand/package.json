{
  "name": "@hufra/brand",
  "private": true,
  "version": "0.1.0",
  "description": "HUFRA design tokens (Direction A, Civic Clarity): one source for the mobile app, admin panel and website",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsx scripts/build.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:assets": "tsx scripts/build-assets.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "harfbuzzjs": "^1.6.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
