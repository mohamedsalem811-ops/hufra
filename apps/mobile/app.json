{
  "expo": {
    "name": "HUFRA",
    "slug": "hufra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../packages/brand/assets/app/icon.png",
    "scheme": "hufra",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "ly.tripoli.hufra",
      "supportsTablet": false,
      "icon": "../../packages/brand/assets/app/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لنضع الحفرة في المكان الصحيح على الخريطة، ولنريك البلاغات القريبة منك.",
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "ly.tripoli.hufra",
      "adaptiveIcon": {
        "backgroundColor": "#0B4A6F",
        "foregroundImage": "../../packages/brand/assets/app/adaptive-foreground.png",
        "backgroundImage": "../../packages/brand/assets/app/adaptive-background.png",
        "monochromeImage": "../../packages/brand/assets/app/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar",
            "en"
          ],
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4A6F",
          "image": "../../packages/brand/assets/app/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B141B",
            "image": "../../packages/brand/assets/app/splash-icon.png"
          }
        }
      ],
      [
        "./plugins/with-display-name",
        {
          "displayName": "حفرة"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لنضع الحفرة في المكان الصحيح على الخريطة، ولنريك البلاغات القريبة منك.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../../packages/brand/assets/app/notification-icon.png",
          "color": "#0B4A6F",
          "defaultChannel": "default"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "نستخدم الكاميرا لتصوير الحفرة التي تبلّغ عنها.",
          "photosPermission": "نستخدم صورك فقط عندما تختار صورة للحفرة من المعرض.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
