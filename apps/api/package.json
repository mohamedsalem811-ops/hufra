{
  "name": "@hufra/api",
  "private": true,
  "version": "0.0.0",
  "description": "HUFRA on one Cloudflare Worker: the API (Hono), and the website and admin panel it serves (apps/web, apps/admin). See docs/EXECUTION_PLAN.md.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:site && wrangler dev --port 3000",
    "deploy": "npm run build:site && wrangler deploy",
    "build:site": "npm run build -w @hufra/web && npm run build -w @hufra/admin && tsx scripts/assemble-site.ts",
    "assemble": "tsx scripts/assemble-site.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply hufra-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply hufra-production",
    "db:console:local": "wrangler d1 execute hufra-production --local",
    "db:console:prod": "wrangler d1 execute hufra-production",
    "db:seed": "wrangler d1 execute hufra-production --local --file=./migrations/0003_seed_regions.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "admin:set-password": "node scripts/set-admin-password.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "zod": "^4.6.7",
    "@hufra/contracts": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
