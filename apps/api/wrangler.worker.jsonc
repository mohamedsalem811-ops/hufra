{
  // HUFRA on Cloudflare Workers + Static Assets (Phase 3.1 of docs/EXECUTION_PLAN.md).
  //
  // Runs ALONGSIDE the Pages project (wrangler.jsonc) until the switch-over in
  // Phase 9: same code, same D1 database, R2 bucket and KV namespace, new address
  // https://hufra.mohamedsalem811.workers.dev. CI deploys both on every push to main.
  //
  // Deploy:  npx wrangler deploy -c wrangler.worker.jsonc --define __BUILD_ID__:'"<commit>"'
  // (__BUILD_ID__ stamps /static/css|js URLs so browsers fetch new files after each deploy.)
  // Local:   npx wrangler dev -c wrangler.worker.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hufra",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Files in public/ are served directly (before the Worker code), with the
  // cache rules in public/_headers. Everything else reaches the Hono app.
  // Plan 9.1: one Worker, three surfaces. site/ holds the website (root), the
  // admin panel (/admin/) and the old pages' files, built by `npm run build:site`
  // (scripts/assemble-site.ts). Files are served directly with site/_headers;
  // everything else (the API, shared report pages, admin screens) reaches the code,
  // which reads pages from the files through the ASSETS binding.
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Pages live at /how, not /how/ (the addresses in the sitemap and canonical links).
    "html_handling": "drop-trailing-slash"
  },

  // Free Workers Logs: request logs and console output in the Cloudflare dashboard.
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hufra-production",
      "database_id": "1a28d545-16ac-4062-ac5f-4348d9edf6cc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "hufra-photos" }],
  "kv_namespaces": [{ "binding": "KV", "id": "e926e97015c54e1e979ff8eb3ba0e92c" }],

  // Plan 9.1: the daily clean-up (src/lib/cleanup.ts), 03:17 UTC = 05:17 in Libya.
  "triggers": { "crons": ["17 3 * * *"] },

  // Plan 8.5: the signing key allowed to open /r/ links in the Android app.
  // For now the public React Native template debug key that signs the test
  // APKs (owner testing only); replaced by the Play signing key in Phase 10.
  "vars": {
    "ANDROID_CERT_SHA256": "FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C"
  }

  // Secrets (set per Worker, not copied from Pages):
  //   JWT_SECRET           generated automatically by CI on first deploy (see .github/workflows/ci.yml)
  //   ADMIN_WHATSAPP       optional, WhatsApp number for the contact button
  //   FCM_SERVICE_ACCOUNT  optional, Firebase key for Android push
}
