# Static headers (Cloudflare Pages and Workers Static Assets both read this file).
# Vendor libs/fonts never change in place -> cache for a year.
/static/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/static/img/*
  Cache-Control: public, max-age=2592000
# First-party css/js are referenced as ?v=<build id>, so a new deploy = new URL.
/static/css/*
  Cache-Control: public, max-age=31536000, immutable
/static/js/*
  Cache-Control: public, max-age=31536000, immutable
# These must always be revalidated.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
# Brand kit copied from packages/brand (fonts and logo change only with a new name).
/static/brand/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/static/brand/*
  Cache-Control: public, max-age=86400
