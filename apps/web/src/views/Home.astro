---
import { markUrl } from '../brand'
import StoreBadges from '../components/StoreBadges.astro'
import { clientMessages, href, t, type Locale } from '../i18n/i18n'
import Base from '../layouts/Base.astro'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const steps = [1, 2, 3, 4] as const
const tiles = [
  ['reports', 'home.reports', null],
  ['fixed', 'home.fixed', null],
  ['avg_fix_days', 'home.avg', 'unit.days'],
  ['confirmed_lyd', 'home.donations', 'money.lyd'],
] as const
---

<Base locale={locale} title={t(locale, 'home.title')}>
  <section class="mx-auto grid max-w-[1200px] items-center gap-10 px-4 pt-12 pb-10 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:pt-16">
    <div class="flex flex-col gap-4">
      <p class="m-0 text-[15px] font-semibold text-secondary">{t(locale, 'home.place')}</p>
      <h1 class="m-0 text-[40px] leading-tight font-bold sm:text-[56px]">{t(locale, 'home.hero')}</h1>
      <p class="m-0 max-w-[620px] text-lg leading-[1.8] text-secondary sm:text-[19px]">{t(locale, 'home.lead')}</p>
      <StoreBadges locale={locale} />
    </div>
    <div aria-hidden="true" class="relative mx-auto flex w-full max-w-[380px] flex-col gap-4 rounded-[28px] bg-brand p-6 text-on-brand shadow-lg">
      <img src={markUrl} alt="" width="56" height="56" class="size-14 rounded-2xl bg-white p-2" />
      <div class="grid grid-cols-2 gap-3">
        <span class="flex flex-col rounded-2xl bg-white/12 p-4"><span class="text-3xl font-bold" data-num="reports">—</span><span class="text-sm opacity-90">{t(locale, 'home.heroNew')}</span></span>
        <span class="flex flex-col rounded-2xl bg-white/12 p-4"><span class="text-3xl font-bold" data-num="fixed">—</span><span class="text-sm opacity-90">{t(locale, 'home.heroFixed')}</span></span>
      </div>
      <div class="h-2 overflow-hidden rounded-full bg-white/20"><span class="block h-full w-0 rounded-full bg-action transition-[width] duration-700" data-fixed-bar></span></div>
      <div class="flex flex-col gap-2 opacity-70">
        <span class="h-3 w-3/4 rounded-full bg-white/30"></span>
        <span class="h-3 w-1/2 rounded-full bg-white/30"></span>
      </div>
    </div>
  </section>

  <section aria-labelledby="nums" class="border-y border-default bg-surface">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-12 sm:px-6">
      <h2 id="nums" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.numbers')}</h2>
      <dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4" aria-live="polite">
        {
          tiles.map(([key, label, unit]) => (
            <div class="flex flex-col-reverse gap-1 rounded-[18px] bg-canvas p-5">
              <dt class="text-[15px] text-secondary">{t(locale, label)}</dt>
              <dd class="m-0 text-[36px] font-bold">
                <span data-num={key}>—</span>
                {unit ? <span data-unit hidden class="text-lg font-semibold"> {t(locale, unit)}</span> : null}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="m-0 text-secondary" data-numbers-error hidden>{t(locale, 'home.numbersUnavailable')}</p>
    </div>
  </section>

  <section aria-labelledby="how" class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-14 sm:px-6">
    <h2 id="how" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.how')}</h2>
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-4 p-0">
      {
        steps.map((n) => (
          <li class="flex flex-col gap-2 rounded-[20px] border border-default bg-surface p-5">
            <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-brand-tint text-lg font-bold text-brand">{n}</span>
            <span class="text-lg font-semibold">{t(locale, `home.step${n}`)}</span>
            <span class="leading-[1.7] text-secondary">{t(locale, `home.step${n}Text`)}</span>
          </li>
        ))
      }
    </ol>
    <a href={href(locale, '/how')} class="flex min-h-11 items-center self-start font-semibold">{t(locale, 'home.howMore')}</a>
  </section>

  <section aria-labelledby="fixed-title" class="border-y border-default bg-surface" data-showcase hidden>
    <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="fixed-title" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.fixedTitle')}</h2>
        <span class="text-secondary">{t(locale, 'home.fixedLead')}</span>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4" data-showcase-list></div>
    </div>
  </section>

  <section aria-labelledby="camp" class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-14 sm:px-6" data-campaigns hidden>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="camp" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.campaigns')}</h2>
      <span class="text-secondary">{t(locale, 'home.campaignsLead')}</span>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4" data-campaigns-list></div>
  </section>

  <section aria-labelledby="partners" class="border-y border-default bg-surface" data-partners hidden>
    <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-col gap-1">
          <h2 id="partners" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.partners')}</h2>
          <span class="text-secondary">{t(locale, 'home.partnersLead')}</span>
        </div>
        <a data-contact-email hidden class="flex min-h-11 items-center font-semibold">{t(locale, 'home.becomePartner')}</a>
      </div>
      <div data-partners-featured></div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-3" data-partners-list></div>
    </div>
  </section>

  <section id="download" aria-labelledby="dl" class="bg-brand-tint">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6 px-4 py-14 sm:px-6">
      <div class="flex flex-col gap-2">
        <h2 id="dl" class="m-0 text-[28px] font-bold sm:text-[34px]">{t(locale, 'home.dl')}</h2>
        <p class="m-0 text-lg text-secondary">{t(locale, 'home.dlLead')}</p>
      </div>
      <StoreBadges locale={locale} />
    </div>
  </section>

  <script is:inline type="application/json" id="i18n" set:html={JSON.stringify({ locale, m: clientMessages(locale) })} />
</Base>

<script>
  import { startHome } from '../scripts/home'
  startHome()
</script>
