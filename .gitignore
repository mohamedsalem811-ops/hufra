
# prod
dist/
# ...except the brand package's generated tokens, which are committed (other apps import them; CI checks they are current)
!packages/brand/dist/

# dev
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/
.wrangler

# env and secrets
.env
.env.production
.dev.vars

# Local admin password reset files
.admin-reset.sql
reset-admin.cjs

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# misc
.DS_Store

# test coverage reports
coverage/

# local QA tooling/screenshots
.qa/

# generated native bundle (built by apps/api/scripts/build-app.mjs; index.html stays as a placeholder)
apps/api/www/*
!apps/api/www/index.html
